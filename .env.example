# Copia este archivo a .env (NO se versiona) o exporta las variables en tu shell.
# Cada key de eToro sirve para UN solo entorno (Demo o Real). Crea la Demo con permiso Write
# para probar; la Real con whitelist de IP y fecha de expiración corta.
# Las keys se crean en https://api-portal.etoro.com/

# demo | real   (por defecto: demo)
ETORO_MODE=demo

# Key de la aplicación (x-api-key)
ETORO_API_KEY=

# Key de usuario (x-user-key)
ETORO_USER_KEY=

# Doble candado para operar con dinero real. Solo tiene efecto si ETORO_MODE=real.
# Si no es exactamente "true", las herramientas de ejecución se niegan a operar en Real.
ETORO_ALLOW_REAL_TRADING=false

# Opcional: ruta a los archivos de configuración y bitácora (por defecto, la raíz del repo)
# ETORO_MCP_HOME=/ruta/al/repo
